# Copy to .env (or export directly in your shell) -- never commit real keys.

# Anthropic (claude-sonnet-5)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI (gpt-4o)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Hugging Face Inference Providers -- covers the two open-weight models served there
# (Meta-Llama-3.1-8B-Instruct, Qwen2.5-7B-Instruct). The token needs the "Make calls to
# Inference Providers" permission enabled (set when creating/regenerating it at
# https://huggingface.co/settings/tokens) or every call 403s regardless of the model.
HF_TOKEN=hf_...
# Override the hosted repo ID for either open model if needed:
# HF_LLAMA_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
# HF_QWEN_MODEL=Qwen/Qwen2.5-7B-Instruct

# Mistral AI's own API (api.mistral.ai) -- used for Mistral-7B instead of Hugging Face, since no
# HF Inference Providers route currently serves a Mistral-7B-Instruct checkpoint with chat
# support. "open-mistral-7b" is Mistral's own hosted ID for the original open 7B checkpoint.
MISTRAL_API_KEY=...
MISTRAL_MODEL=open-mistral-7b

NUM_PAYLOAD_VARIANTS=2
