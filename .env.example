# Copy to .env (or export directly in your shell) -- never commit real keys.

# Anthropic (claude-sonnet-5)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI (gpt-4o)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Hugging Face Inference API -- covers the three open-weight models (Meta-Llama-3.1-8B-Instruct,
# Mistral-7B, Qwen2.5-7B-Instruct). Needs "Inference" permission on the token.
HF_TOKEN=hf_...
# Override the hosted repo ID for any of the three open models if needed:
# HF_LLAMA_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
# HF_MISTRAL_MODEL=mistralai/Mistral-7B-Instruct-v0.3
# HF_QWEN_MODEL=Qwen/Qwen2.5-7B-Instruct

NUM_PAYLOAD_VARIANTS=2
